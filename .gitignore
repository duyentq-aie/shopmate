# Secrets and local configuration
.env
.env.*
!.env.example

# Local data (Qdrant storage, eval runs, exports). The synthetic seed catalog,
# seed orders, policy documents and the index manifest are versioned on purpose.
data/*
!data/seed/
!data/policies/
!data/index/
# (data/tickets/tickets.jsonl, the tickets the agent writes, is covered by data/*: it holds customer emails)

# Qdrant local storage
qdrant_storage/
qdrant_data/
.qdrant/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Logs and OS noise
*.log
.DS_Store

# Request traces (one JSON line per request, app/tracing.py)
logs/
