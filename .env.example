# ShopMate configuration template. Copy to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets. Every value below is a placeholder.

# --- Saleor (Phase 1) ---
# GraphQL endpoint of the Saleor API. Local dev: http://localhost:8000/graphql/
SALEOR_API_URL=your-saleor-graphql-url
# Channel slug used for catalog and pricing. Local demo data: default-channel
SALEOR_CHANNEL=your-channel-slug

# Phase 1 ONLY: staff login used by scripts/check_saleor.py to read the order count.
# Pass these through the shell environment at run time; do not store real values in a file.
# From Phase 2 onward the service authenticates with SALEOR_RUNTIME_TOKEN, never a staff account.
SALEOR_STAFF_EMAIL=your-staff-email
SALEOR_STAFF_PASSWORD=your-staff-password

# Saleor App tokens (Phase 2+). See docs/SETUP.md for the permissions of each app.
# shopmate-seeder: writes the synthetic catalog and test orders. Local use only.
SALEOR_SEEDER_TOKEN=your-seeder-app-token
# shopmate-runtime: used by the AI service; read-only enforced in app/saleor/readonly_client.py.
SALEOR_RUNTIME_TOKEN=your-runtime-app-token

# --- LLM / embeddings ---
GEMINI_API_KEY=your-gemini-api-key

# --- Typesafe ---
TYPESAFE_API_KEY=your-typesafe-api-key

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# Langfuse Cloud is the default; set this only for another region or a self-hosted server. (The SDK now prefers the name LANGFUSE_BASE_URL; either works here.)
# LANGFUSE_HOST=https://cloud.langfuse.com
# Both keys unset (or left as the your-... placeholders): Langfuse is off, nothing is sent, and the system runs as before.

# --- Vector store ---
# Qdrant endpoint. Typical local value: http://localhost:6333
QDRANT_URL=your-qdrant-url
